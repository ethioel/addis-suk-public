# Addis Suk Bot - Environment Configuration
# Copy to .env and fill in your values

# === REQUIRED ===
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321

# === OPTIONAL ===
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Search radius in kilometers
SEARCH_RADIUS_KM=10

# Free tier limits
FREE_SEARCH_LIMIT=5
FREE_ITEMS_LIMIT=10
PREMIUM_ALERTS_LIMIT=10
PRICE_HISTORY_DAYS=30

# Pricing (in Ethiopian Birr)
BUYER_PREMIUM_PRICE=100
SELLER_PREMIUM_PRICE=250
FEATURED_LISTING_PRICE=50
VERIFIED_BADGE_PRICE=100
PROMOTIONAL_BROADCAST_PRICE=100
BULK_DISCOUNT_FEATURE_PRICE=150