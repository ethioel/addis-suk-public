# Hugging Face Spaces Configuration
# https://huggingface.co/spaces

# This file is used by HF Spaces to configure the deployment
# It's placed in the root of the repository

[build]
python_version = "3.11"
# Use the minimal CPU-only image
base_image = "python:3.11-slim"

[run]
# Run the app.py which handles both web server and Telegram bot
command = "python -m src.app"

[env]
# Required environment variables (set via HF Secrets)
# BOT_TOKEN = ""
# ADMIN_IDS = ""
LOG_LEVEL = "INFO"
SEARCH_RADIUS_KM = "10"
FREE_SEARCH_LIMIT = "5"
FREE_ITEMS_LIMIT = "10"
PREMIUM_ALERTS_LIMIT = "10"
PRICE_HISTORY_DAYS = "30"
BUYER_PREMIUM_PRICE = "100"
SELLER_PREMIUM_PRICE = "250"
FEATURED_LISTING_PRICE = "50"
VERIFIED_BADGE_PRICE = "100"
PROMOTIONAL_BROADCAST_PRICE = "100"
BULK_DISCOUNT_FEATURE_PRICE = "150"